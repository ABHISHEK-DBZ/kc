# ============================================================
# KhataCopilot HQ — Enterprise Environment Configuration
# ============================================================

# Server Port
PORT=3001

# JWT Secret for Session & Route Security
JWT_SECRET=your_jwt_secret_key_here_generate_with_openssl

# Groq LLM API Key (Required for AI Reasoning, Issue Classification, and Community Copilot)
# Groq keys MUST only exist server-side and never exposed to the client.
GROQ_API_KEY=your_groq_api_key_here_gsk_xxx

# Database Mode (SQLite local / PostgreSQL / Supabase)
DATABASE_URL=file:./data/khatacopilot.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Node Environment
NODE_ENV=development
